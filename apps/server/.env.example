# =============================================================
# topEleven-gamepress — Server (Elysia + tRPC + Better-Auth)
# =============================================================
# 1) Sao chép file này thành .env và điền giá trị thật.
# 2) KHÔNG commit file .env thật vào git (đã được .gitignore bảo vệ).
# 3) Connection string Neon mẫu trong commit cũ là database tạm thời
#    (claimable, hạn 11/09/2026) — luôn dùng DB do bạn tạo.
# =============================================================

# ---- Database ------------------------------------------------------------
# Connection string tới PostgreSQL (Neon / Supabase / local đều được).
# Bắt buộc cho cả server runtime lẫn drizzle-kit push/studio/seed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---- Better-Auth ---------------------------------------------------------
# Sinh bằng:    openssl rand -base64 48
# YÊU CẦU >= 32 ký tự. Đổi secret khi nghi ngờ lộ.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-48

# URL gốc của server (không kèm dấu / ở cuối).
# Local mặc định: http://localhost:3000
# Production:     https://your-server.example.com
BETTER_AUTH_URL=http://localhost:3000

# ---- CORS ----------------------------------------------------------------
# URL gốc của web, cho phép credentials.
# Local mặc định: http://localhost:3001
# Production:     https://your-web.example.com
CORS_ORIGIN=http://localhost:3001

# ---- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Cổng server (Elysia). Mặc định 3000, Render/Vercel tự set PORT.
PORT=3000