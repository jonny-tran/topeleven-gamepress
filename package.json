{
  "name": "topEleven-gamepress",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.0",
      "@types/node": "^26.2.0",
      "elysia": "^1.4.29",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.7.1",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "nanoid": "^5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @topEleven-gamepress/db --",
    "db:studio": "turbo run db:studio -F @topEleven-gamepress/db --",
    "db:generate": "turbo run db:generate -F @topEleven-gamepress/db --",
    "db:migrate": "turbo run db:migrate -F @topEleven-gamepress/db --",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.9",
    "@topEleven-gamepress/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@topEleven-gamepress/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "nanoid": "catalog:",
    "tsx": "^4.23.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vercel": "^58.1.0"
  },
  "packageManager": "bun@1.4.2"
}
